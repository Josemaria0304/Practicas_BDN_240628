  "cards": [
    {
      "dot": "cyan",
      "title": "Alcance",
      "items": ["Fuente y conteos: Practica03/backups/Respaldo-20261014.sql; números calculados sobre las tuplas INSERT del respaldo.", "13 tablas de db_test en MySQL 8.0.36; se muestran solo relaciones declaradas por FOREIGN KEY."]
    },
    {
      "dot": "amber",
      "title": "Reglas del esquema",
      "items": [
        "NN = NOT NULL; si falta NN, la columna admite NULL. AI = AUTO_INCREMENT. C = DEFAULT CURRENT_TIMESTAMP. =valor = DEFAULT explícito. U = ON UPDATE CURRENT_TIMESTAMP. G = GENERATED STORED; fórmula quantity * unit_price.",
        "UNIQUE: tb_carts.user_ID; tbd_shopping_cart(user_ID, product_ID); además de las claves marcadas en tablas.",
        "tbc_categories.sup_id_category es una FK opcional a tbc_categories.ID (jerarquía); se documenta aquí porque el ERD no admite auto-conectores.",
        "ENUM: tbb_orders.status_string = Registered, Wishlist, Payed, Canceled, Delivered, Devolved, Attended, Sended; tbd_payments.payment_status = Pendiente, Procesando, Pagado, Rechazado, Reembolsado, Cancelado.",
        "ENUM: tbd_users_offer_products.type_ownership = Owner, Reseller, Distributor; tb_logs.operation = Create, Read, Update, Delete.",
        "CHECK: tbd_order_details.unit_price >= 0 y quantity > 0; tbd_payments.amount > 0; tbd_shopping_cart.quantity > 0. user_ID en tbd_shopping_cart tiene ON DELETE CASCADE. tb_logs no declara claves foráneas.",
        "Las tablas usan InnoDB y utf8mb4; los conteos describen este respaldo, no una conexión en vivo."
      ]
    }
  ]
